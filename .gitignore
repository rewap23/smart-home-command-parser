# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Environments
.venv/
.env
.env.*
!.env.example

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Build and packaging
build/
dist/
*.egg-info/

# Training and data
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
artifacts/*
!artifacts/.gitkeep
*.pt
*.pth
*.onnx

# Operating system and editor files
.DS_Store
.vscode/
.idea/

# Generated dataset files
data/raw/*.jsonl
data/processed/*.jsonl

# Large model binaries
artifacts/**/*.pt
artifacts/**/*.pth
artifacts/**/*.onnx

# Keep reproducibility artifacts
!artifacts/**/metadata.json
!artifacts/**/metrics.json
!artifacts/**/training_history.json
!artifacts/**/vocab.json
!artifacts/**/label_encoders.json
!artifacts/**/model.pt.sha256